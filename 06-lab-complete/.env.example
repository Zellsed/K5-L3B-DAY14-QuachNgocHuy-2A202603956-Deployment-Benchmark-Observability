# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã nằm trong .gitignore).
# Trên Railway / Render: đặt các biến này trong phần Variables / Environment của service.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — bắt buộc. Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (rate limit + cost guard). Docker Compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
